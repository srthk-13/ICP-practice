class Solution {
    public boolean dfs(int node, ArrayList<ArrayList<Integer>> adj, boolean visited[], int color[], int currColor){
        visited[node]=true;
        color[node]=currColor;
        for(int i=0;i<adj.get(node).size();i++){
            int neighbour=adj.get(node).get(i);
            if(!visited[neighbour]){
                if(!dfs(neighbour,adj,visited,color,-currColor)) return false;
            }
            else if(color[node]==color[neighbour]) return false;
        }
        return true;
    }

    public boolean possibleBipartition(int n, int[][] dislikes) {
        ArrayList<ArrayList<Integer>> adj=new ArrayList<>();
        int color[]=new int[n];
        boolean visited[]=new boolean[n];
        for(int i=0;i<n;i++) adj.add(new ArrayList<>());
        for(int i=0;i<dislikes.length;i++){
            int p1=dislikes[i][0]-1;
            int p2=dislikes[i][1]-1;
            adj.get(p1).add(p2);
            adj.get(p2).add(p1);
        }
        for(int i=0;i<n;i++){
            if(!visited[i]){
                if(!dfs(i,adj,visited,color,-1)) return false;
            }
        }
        return true;
    }
}
