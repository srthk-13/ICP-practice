class Solution {
    public boolean helper(int node, int grid[][], int state[]){
        if(state[node]!=0){
            return state[node]==2;
        }

        state[node]=1;

        for(int i=0;i<grid[node].length;i++){
            int neighbour=grid[node][i];
            if(state[neighbour]==1) return false;

            if(!helper(neighbour, grid, state)) return false;
        }

        state[node]=2;
        return true;

    }
    
    public List<Integer> eventualSafeNodes(int[][] graph) {
        int n=graph.length;
        int state[]=new int[n];

        List<Integer> ans=new ArrayList<>();

        for(int i=0;i<n;i++){
            if(helper(i, graph, state)){
                ans.add(i);
            }
        }
    
        return ans;
    }
}
