class Solution {
    public int swimInWater(int[][] grid) {
        int m=grid.length, n=grid[0].length;

        PriorityQueue<int[]> pq= new PriorityQueue<>((a,b)-> a[2]-b[2]);
        boolean visited[][]=new boolean[m][n];

        pq.add(new int[]{0, 0, grid[0][0]});

        int dr[]={-1, 1, 0, 0};
        int dc[]={0, 0, -1, 1};
        
        while(!pq.isEmpty()){
            int curr[]=pq.poll();

            int x=curr[0], y=curr[1], target=curr[2];

            if(visited[x][y]) continue;
            visited[x][y]=true;

            if(x==m-1 && y==n-1) return target;

            for(int i=0;i<4;i++){
                int nx=x+dr[i];
                int ny=y+dc[i];

                if(nx>=0 && nx<m && ny>=0 && ny<n && !visited[nx][ny]){
                    pq.add(new int[]{nx, ny, Math.max(target, grid[nx][ny])});
                }
            }
        }

        return -1;
    }
}
