class Solution {
    public int totalSteps(int[] nums) {
        int n=nums.length;
        int dp[]=new int[n];
        int ans=0;
        Stack<Integer> st=new Stack<>();
        for(int i=n-1;i>=0;i--){
            int curr=0;
            while(!st.isEmpty() && nums[i]>nums[st.peek()]){
                curr=Math.max(curr+1, dp[st.pop()]);
            }
            dp[i]=curr;
            ans=Math.max(curr,ans);
            st.push(i);
        }
        return ans;
    }
}
